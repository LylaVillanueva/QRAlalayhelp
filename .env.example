# Copy to .env locally. Never commit .env or put server credentials in Expo's
# EXPO_PUBLIC_* variables; those values are included in the client bundle.
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0

# Supabase project settings. Keep the service-role key and database URL server-side.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Generate two different random values of at least 32 bytes for production.
JWT_ACCESS_SECRET=SET_A_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=SET_A_DIFFERENT_RANDOM_REFRESH_SECRET
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Development only. Production always uses a cryptographically random code.
OTP_DEVELOPMENT_CODE=123456
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5

# Email OTPs use Resend's sign-up-confirmation template. Phone OTP delivery
# is not implemented; phone login is deliberately unavailable in production.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=alerts@example.invalid
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=ResQR

EXPO_PUSH_ACCESS_TOKEN=
WEB_DASHBOARD_ORIGIN=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
MOBILE_APP_BUNDLE_IDS=ph.resqr.mobile,ph.resqr.mobile.dev
BOOTSTRAP_SECRET=

QR_TOKEN_LENGTH_BYTES=24
QR_LEVEL_Q_ERROR_CORRECTION=Q
INCIDENT_TIMEOUT_MINUTES=10
INCIDENT_GUARDIAN_GRACE_PERIOD_MINUTES=45
INCIDENT_CANCEL_WINDOW_MINUTES=5
INCIDENT_REPEAT_REPORT_NOTICE_MINUTES=2
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=ResQR emergency alert app
